# Copy to .env on the server. Never commit a real .env.
# Hostinger hPanel → Databases: use the FULL prefixed names shown there.

APP_NAME=PMRatnam
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pmratnam.com

# PHP 8.1+ in hPanel → PHP Configuration
# DB_HOST is localhost on Hostinger shared hosting in most cases.
# If hPanel lists a remote host (e.g. srv123.hstgr.io), use that instead.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_pmratnam
DB_USER=u000000000_admin
DB_PASS=change-me
DB_CHARSET=utf8mb4
# Optional, only if hPanel says to use a socket:
# DB_SOCKET=/tmp/mysql.sock

SESSION_NAME=pmratnam_admin
# Idle timeout in seconds (8 hours)
SESSION_LIFETIME=28800
